@page "/LibrosIndex"

@using Models
@using Services

@inject LibrosServices librosS

@rendermode InteractiveServer

<PageTitle>Base de Datos Literaria</PageTitle>

<div class="p-3 border rounded">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h3 class="mb-0">
            Listado de Libros
        </h3>

        <a href="/crearLibro" class="btn btn-primary">
            Agregar Libro
        </a>

    </div>


    <div class="row align-items-end mb-4">

        <div class="col-md-3">

            <label class="form-label">
                Filtrar por
            </label>

            <select class="form-select" @bind="filtroPor">

                <option value="">
                    Selecciona una opción
                </option>

                <option value="LibroID">
                    LibroID
                </option>

                <option value="Titulo">
                    Título
                </option>

                <option value="Autor">
                    Autor
                </option>

                <option value="AnioPublicacion">
                    Año Publicación
                </option>

            </select>

        </div>


        <div class="col-md-4">

            <label class="form-label">
                Buscar
            </label>

            <div class="input-group">

                <input class="form-control"
                       @bind="filtro"
                       placeholder="Buscar" />

                <button type="button"
                        class="btn btn-outline-primary"
                        @onclick="Buscar">

                    Buscar

                </button>

            </div>

        </div>


        <div class="col-md-2">

            <button type="button"
                    class="btn btn-outline-secondary"
                    @onclick="Limpiar">

                Limpiar

            </button>

        </div>

    </div>


    
    <div class="table-responsive">

        <table class="table table-striped table-hover align-middle">

            <thead>

                <tr>

                    <th>LibroID</th>

                    <th>Título</th>

                    <th>Autor</th>

                    <th>Año de Publicación</th>

                    <th>Acciones</th>

                </tr>

            </thead>


            <tbody>

                @if (libros.Count == 0)
                {
                    <tr>

                        <td colspan="5"
                            class="text-center text-muted">

                            No se encontraron libros.

                        </td>

                    </tr>
                }
                else
                {
                    @foreach (var libro in libros)
                    {
                        <tr>
                            <td>
                                @libro.LibroID
                            </td>
                            <td>
                                @libro.Titulo
                            </td>
                            <td>
                                @libro.Autor
                            </td>
                            <td>
                                @libro.AnoPublicacion
                            </td>

                            <td>
                                <a href="@($"/modificarLibro/{libro.LibroID}")"
                                   class="btn btn-primary btn-sm me-1"
                                   title="Editar">

                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                <button type="button"
                                        class="btn btn-danger btn-sm"
                                        title="Eliminar"
                                        @onclick="() => Eliminar(libro)">

                                    <i class="bi bi-trash"></i>

                                </button>

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

</div>


@code {

    private List<Libros> libros = new();

    private string filtro { get; set; } = string.Empty;

    private string filtroPor { get; set; } = string.Empty;


    protected override void OnInitialized()
    {
        CargarLibros();
    }


    private void CargarLibros()
    {
        libros = librosS.Listar(l => true);
    }


    private async Task Eliminar(Libros libro)
    {
        bool resultado = await librosS.Eliminar(libro.LibroID);

        if (resultado)
        {
            CargarLibros();
        }
    }


    private void Buscar()
    {
        if (string.IsNullOrWhiteSpace(filtro))
        {
            CargarLibros();
            return;
        }


        string texto = filtro.Trim();


        if (filtroPor == "Autor")
        {
            libros = librosS.Listar(l =>
                l.Autor != null &&
                l.Autor.ToLower().Contains(texto.ToLower()));
        }


        else if (filtroPor == "Titulo")
        {
            libros = librosS.Listar(l =>
                l.Titulo != null &&
                l.Titulo.ToLower().Contains(texto.ToLower()));
        }


        else if (filtroPor == "LibroID")
        {
            if (int.TryParse(texto, out int id))
            {
                libros = librosS.Listar(l =>
                    l.LibroID == id);
            }
            else
            {
                libros = new List<Libros>();
            }
        }


        else if (filtroPor == "AnioPublicacion")
        {
            libros = librosS.Listar(l =>
                l.AnoPublicacion == texto);
        }


        else
        {
            CargarLibros();
        }
    }


    private void Limpiar()
    {
        filtro = string.Empty;

        filtroPor = string.Empty;

        CargarLibros();
    }

}