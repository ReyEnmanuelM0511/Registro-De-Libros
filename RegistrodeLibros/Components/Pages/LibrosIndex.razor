@page "/LibrosIndex"
@using Models
@using Services
@inject LibrosServices librosS
@rendermode InteractiveServer

<PageTitle>Base de Datos Literaria</PageTitle>

<div class="p-3 border rounded">
    <div class="justify-content-between align-items-lg-center d-flex">
        <h3>Listado de Libros</h3>
        <a href="/crearLibro" class="btn btn-primary"> Agregar Libro</a>
    </div>
        
    <div>
        <table>
            <thead>
                <tr>
                    <th>LibroId</th>
                    <th>Titulo</th>
                    <th>Autor</th>
                    <th>AñodePublicacion</th>
                </tr>
            </thead>

            <tbody>
                @foreach(var libro in librosS)
                {
                    <tr>
                        <td>@libro.LibroId</td>
                        <td>@libro.Titulo</td>
                        <td>@libro.Autor</td>
                        <td>@libro.AñodePublicacion</td>
                    </tr>
                }
            </tbody>
        </table>
        

    </div>
</div>